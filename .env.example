# Optional local .env; npm run dev/start/server/backup load it.
# Keep defaults for the existing local development experience.
# Production settings (set these in Vercel, for each deployment environment):
# NODE_ENV=production
# PUBLIC_ORIGIN=https://little-stay.example.com
# TRUST_PROXY=1
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=replace-with-a-unique-long-password
# LITTLE_STAY_SEED=demo  # only for an intentionally public fictional demo
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=replace-with-your-database-token
# BLOB_READ_WRITE_TOKEN=replace-with-the-token-from-your-public-vercel-blob-store
# Optional Google OAuth: set all three to enable the Google button.
# GOOGLE_CLIENT_ID=your-web-client.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://little-stay.example.com/api/auth/google/callback
# Local-only data settings (Vercel never uses these):
# LITTLE_STAY_DATA_DIR=.local/data
# HOST=127.0.0.1
# API_PORT=3001

# Public build settings; never put secrets in VITE_ variables.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Optional fictional 55-listing course showcase; requires LITTLE_STAY_SEED=demo
# LITTLE_STAY_DEMO_PROFILE=voronoi

{
  "name": "little-stay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "backup": "node --env-file-if-exists=.env --import tsx scripts/backup.mjs",
    "migrate:cloud": "node --env-file-if-exists=.env --import tsx scripts/migrate-cloud.mjs",
    "format": "prettier --write src server scripts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "2.4.0",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "multer": "^2.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/leaflet": "^1.9.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
